# Para ~/.hermes/.env (fuera de git). Nunca pegues las llaves en el chat ni las subas al repo.

# La clave de este Hermes (la del área). Es la misma en tres lugares, y la pone TI una sola vez:
#   · API_SERVER_KEY: con ella el portal le habla a este Hermes;
#   · OPENAI_API_KEY: con ella este Hermes entra a la pasarela del portal;
#   · en el portal, JARVIS_HERMES = {"CRM": {"url": "http://127.0.0.1:8642", "clave": "<esta>"}}.
# Nadie del equipo genera llaves: el portal sabe quién chatea y le cobra a esa persona.
# La clave de DeepSeek NO va aquí: vive en el portal.
API_SERVER_KEY=
OPENAI_API_KEY=

# Las herramientas del portal (mcp-portal.mjs) usan la misma clave y leen como la persona que chatea.
