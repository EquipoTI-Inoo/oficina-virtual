{
  "manifest_version": 3,
  "name": "Jarvis de Inoo",
  "version": "2.1.0",
  "description": "Tu Jarvis del portal de Inoo en el panel lateral de Chrome: chatea con tus bots y deja que usen tu Chrome, con tu aprobación.",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "sidePanel", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "fondo.js" },
  "action": { "default_title": "Abrir Jarvis" },
  "side_panel": { "default_path": "panel.html" },
  "options_page": "opciones.html"
}
