    },
    {
      "id": "361b4fd9-c4d9-587e-842b-88df867839bb",
      "name": "Verificar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Verifica la firma del despachador del outbox (src/servidor/outbox.ts):\n// X-Inoo-Firma = sha256=HMAC-SHA256(secreto, \"<X-Inoo-Timestamp>.<cuerpo crudo>\").\n// Requiere NODE_FUNCTION_ALLOW_BUILTIN=crypto y la variable INOO_WEBHOOK_SECRETO en n8n.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst h = item.json.headers || {};\nconst secreto = $env.INOO_WEBHOOK_SECRETO;\nif (!secreto) throw new Error('Falta INOO_WEBHOOK_SECRETO en las variables de n8n');\nconst crudo = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst ts = String(h['x-inoo-timestamp'] || '');\nconst firma = String(h['x-inoo-firma'] || '');\nconst esperada = 'sha256=' + crypto.createHmac('sha256', secreto).update(ts + '.' + crudo).digest('hex');\nconst reciente = Math.abs(Date.now() / 1000 - Number(ts)) < 300;\nconst igual = firma.length === esperada.length && crypto.timingSafeEqual(Buffer.from(firma), Buffer.from(esperada));\nreturn [{ json: { valido: Boolean(reciente && igual), evento: igual ? JSON.parse(crudo) : null } }];"
      }
    },
    {
      "id": "2cc4551b-97d4-5354-b493-809a15b65f7f",
      "name": "¿Firma válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
