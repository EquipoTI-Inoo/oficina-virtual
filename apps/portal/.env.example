# ── Portal (apps/portal) ──────────────────────────────────────────────
# mock  = API simulada en memoria (entorno de pruebas, datos de Figma)
# proxy = reenvía /api/v1 a API_URL_BACKEND (backend real o Prism)
API_MODO=mock
API_URL_BACKEND=http://localhost:4010
# Latencia artificial de la API simulada, para ver estados de carga (ms)
MOCK_LATENCIA_MS=0
# Solo contenedores de prueba: permite la API simulada en un build de producción
PERMITIR_MOCK=false

# ── Backend real (API_MODO=db) ─────────────────────────────────────────
# Postgres con database/migraciones aplicadas (0001 esquema, 0002 rol app_portal)
DATABASE_URL=postgres://inoo:inoo@localhost:5432/oficina_virtual
# demo = tokens demo.<usuario_id> (solo desarrollo) · cognito = JWT de los dos user pools
AUTH_MODO=demo
COGNITO_REGION=us-east-1
COGNITO_POOL_EQUIPO=
COGNITO_POOL_CLIENTES=
# App clients públicos del ingreso (ALLOW_USER_PASSWORD_AUTH y ALLOW_REFRESH_TOKEN_AUTH)
COGNITO_APP_CLIENTES=
COGNITO_APP_EQUIPO=
# Otros client ids aceptados en los tokens (opcional), separados por coma
COGNITO_CLIENT_IDS=

# ── Despachador del outbox (npm run outbox) ────────────────────────────
# Correos automáticos: portal = los manda el portal por SMTP (por defecto) · n8n = el workflow correos-por-evento
CORREOS_POR=portal
# En local, Mailpit (bandeja en http://localhost:8025). En producción, el SMTP de Inoo (SES, Workspace…).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=Inoo <no-responder@inoo.pe>
PORTAL_URL=http://localhost:3000
# n8n (opcional): recibe los eventos para las demás automatizaciones
N8N_WEBHOOK_URL=http://localhost:5678/webhook/inoo-eventos
N8N_WEBHOOK_SECRETO=cambiar-por-un-secreto-largo
OUTBOX_INTERVALO_MS=5000

# ── IA: Gemini (Google AI Studio) ─────────────────────────────────────
# La clave real va en .env.local (nunca en este archivo ni en git).
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-latest
# ── IA: Claude (Anthropic) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-sonnet-5-5
# simulado = sin llamadas a la API (por defecto) · real = llama a Gemini/Claude
IA_MODO=simulado
IA_TOPE_DIARIO_USD=2

# ── Taller web (fase 19) ──────────────────────────────────────────────
# simulado = capturas de relleno e informe en HTML · real = Chromium (npx playwright install chromium)
NAVEGADOR_MODO=simulado
# CHROMIUM_PATH=/usr/bin/chromium-browser
# Prototipo en Stitch (MCP de Google). La clave real va en .env.local; sin clave, pantallas de relleno.
STITCH_API_KEY=

# ── API simulada: integraciones (ver docs/entorno-de-pruebas.md) ────────
MOCK_API_KEY=demo-n8n
MOCK_INOOWORK_SECRETO=demo-secreto
# MOCK_N8N_WEBHOOK_URL=http://localhost:5678/webhook/inoo-eventos
# MOCK_N8N_SECRETO=demo-secreto
