# ── Portal (apps/portal) ──────────────────────────────────────────────
# mock  = API simulada en memoria (entorno de pruebas, datos de Figma)
# proxy = reenvía /api/v1 a API_URL_BACKEND (backend real o Prism)
API_MODO=mock
API_URL_BACKEND=http://localhost:4010
# Latencia artificial de la API simulada, para ver estados de carga (ms)
MOCK_LATENCIA_MS=0
# Solo contenedores de prueba: permite la API simulada en un build de producción
PERMITIR_MOCK=false
