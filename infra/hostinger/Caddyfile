{
	email {$CORREO_ACME}
}

{$DOMINIO_PORTAL} {
	# Abierto a internet con su propio ingreso. La clave de caddy-extra queda solo en n8n y NocoDB.
	encode gzip
	reverse_proxy portal:3000
}

{$DOMINIO_N8N} {
	import /etc/caddy/extra/*.caddy
	encode gzip
	reverse_proxy n8n:5678
}

{$DOMINIO_NOCODB} {
	import /etc/caddy/extra/*.caddy
	encode gzip
	reverse_proxy nocodb:8080
}

# 23 nov 2026: InooWork (antes en el hosting compartido). Sin la clave de caddy-extra: tiene su propio ingreso.
{$DOMINIO_INOOWORK} {
	encode gzip
	reverse_proxy inoowork:3000
}
