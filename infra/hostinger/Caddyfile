	email {$CORREO_ACME}
}

{$DOMINIO_PORTAL} {
	# caddy-extra/*.caddy: reglas del servidor que no van al repositorio (clave de acceso de la demo).
	import /etc/caddy/extra/*.caddy
	encode gzip
	reverse_proxy portal:3000
}

{$DOMINIO_N8N} {
	import /etc/caddy/extra/*.caddy
	encode gzip
	reverse_proxy n8n:5678
}

{$DOMINIO_NOCODB} {
	import /etc/caddy/extra/*.caddy
	encode gzip
	reverse_proxy nocodb:8080
}
