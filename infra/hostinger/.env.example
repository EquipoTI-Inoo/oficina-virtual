# Fase 1 (Hostinger). Copiar a .env en el VPS. NUNCA subir el .env al repositorio.
DOMINIO_N8N=n8n.inoo.pe
DOMINIO_NOCODB=panel.inoo.pe
CORREO_ACME=sistemas@inoo.pe

POSTGRES_USER=inoo
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=oficina_virtual

N8N_VERSION=latest          # fijar una versión probada antes de producción
N8N_ENCRYPTION_KEY=         # openssl rand -hex 32  (guardar en el gestor de secretos: sin ella no se descifran las credenciales)
NOCODB_VERSION=latest
NOCODB_JWT_SECRET=          # openssl rand -hex 32

# Conexión portal ↔ n8n (n8n/README.md)
PORTAL_API_URL=             # URL pública del portal, sin /api/v1 (p. ej. https://portal.inoo.pe)
N8N_WEBHOOK_SECRETO=        # openssl rand -hex 32  (el mismo valor va en N8N_WEBHOOK_SECRETO del portal)
CORREO_REMITENTE=Inoo <no-responder@inoo.pe>

# Credenciales que se cargan DENTRO de n8n (no como variables): Google Drive, Gemini, OpenAI,
# Anthropic, Telegram/Slack, API key de integración de InooWork (header x-api-key), SMTP de Inoo
# (credencial «SMTP Inoo») y la llave del portal (credencial «Portal Inoo · X-Api-Key»).
