# Fase 1 (Hostinger). Copiar a .env en el VPS. NUNCA subir el .env al repositorio.
DOMINIO_PORTAL=portal.inoo.pe
DOMINIO_N8N=n8n.inoo.pe
DOMINIO_NOCODB=panel.inoo.pe
CORREO_ACME=sistemas@inoo.pe

POSTGRES_USER=inoo
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=oficina_virtual

N8N_VERSION=latest          # fijar una versión probada antes de producción
N8N_ENCRYPTION_KEY=         # openssl rand -hex 32  (guardar en el gestor de secretos: sin ella no se descifran las credenciales)
NOCODB_VERSION=latest
NOCODB_JWT_SECRET=          # openssl rand -hex 32

# Conexión portal ↔ n8n (n8n/README.md)
N8N_WEBHOOK_URL=            # vacío por ahora; cuando un workflow escuche los eventos: http://n8n:5678/webhook/inoo-eventos
N8N_WEBHOOK_SECRETO=        # openssl rand -hex 32

# ── Portal (servicios portal y outbox) ─────────────────────────────────
AUTH_MODO=cognito
COGNITO_REGION=us-east-1
COGNITO_POOL_CLIENTES=      # us-east-1_xxxxxxxx
COGNITO_POOL_EQUIPO=
COGNITO_APP_CLIENTES=       # client id público del pool de clientes (ALLOW_USER_PASSWORD_AUTH y ALLOW_REFRESH_TOKEN_AUTH)
COGNITO_APP_EQUIPO=
S3_BUCKET=                  # archivos de clientes y del taller web
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=          # IAM: s3:PutObject, s3:GetObject, s3:ListBucket y cognito-idp:AdminCreateUser
AWS_SECRET_ACCESS_KEY=
# Correos: los manda el portal por SMTP (Amazon SES, Google Workspace…)
CORREOS_POR=portal
SMTP_HOST=
SMTP_PORT=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=Inoo <no-responder@inoo.pe>
# IA (IA_MODO=simulado para no gastar)
IA_MODO=real
IA_TOPE_DIARIO_USD=2
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
STITCH_API_KEY=

# Credenciales que se cargan DENTRO de n8n (no como variables): Google Drive, Gemini, OpenAI,
# Anthropic, Telegram/Slack, API key de integración de InooWork (header x-api-key), SMTP de Inoo
# (credencial «SMTP Inoo») y la llave del portal (credencial «Portal Inoo · X-Api-Key»).
